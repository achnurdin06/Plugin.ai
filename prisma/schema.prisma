generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum Role {
  SUPER_ADMIN
  PROMPT_ENGINEER
  SUPPORT_AGENT
  VIEWER
}

enum DocumentStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum FileType {
  PDF
  MARKDOWN
  DOCX
  WEBPAGE
  CSV
}

model Tenant {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              User[]
  appCredentials     AppCredential[]
  promptVersions     PromptVersion[]
  knowledgeDocuments KnowledgeDocument[]
  chatSessions       ChatSession[]
  tokenLogs          TokenConsumptionLog[]
  auditLogs          AuditLog[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]

  @@index([tenantId])
}

model AppCredential {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appKey         String        @unique @default(uuid())
  secretHash     String
  allowedDomains String[]
  isActive       Boolean       @default(true)
  rateLimitRpm   Int           @default(60)
  rateLimitTpm   Int           @default(10000)
  createdAt      DateTime      @default(now())
  chatSessions   ChatSession[]

  @@index([tenantId])
  @@index([appKey])
}

model PromptVersion {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version      Int
  systemPrompt String   @db.Text
  guardrails   String[]
  temperature  Float    @default(0.7)
  topP         Float    @default(0.9)
  maxTokens    Int      @default(1024)
  model        String   @default("gpt-4o-mini")
  isActive     Boolean  @default(false)
  createdBy    String
  createdAt    DateTime @default(now())

  @@unique([tenantId, version])
  @@index([tenantId, isActive])
}

model KnowledgeDocument {
  id         String          @id @default(uuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title      String
  sourceUrl  String?
  fileType   FileType        @default(MARKDOWN)
  status     DocumentStatus  @default(QUEUED)
  chunkCount Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  chunks     VectorChunk[]

  @@index([tenantId])
}

model VectorChunk {
  id         String                                @id @default(uuid())
  documentId String
  document   KnowledgeDocument                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenantId   String
  content    String                                @db.Text
  metadata   Json                                  @default("{}")
  embedding  Unsupported("vector(1536)")?
  chunkIndex Int
  createdAt  DateTime                              @default(now())

  @@index([tenantId])
  @@index([documentId])
}

model ChatSession {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appKey      String
  credential  AppCredential  @relation(fields: [appKey], references: [appKey], onDelete: Cascade)
  visitorId   String
  title       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  messages    ChatMessage[]
  feedback    FeedbackCSAT?

  @@index([tenantId])
  @@index([appKey])
  @@index([visitorId])
}

model ChatMessage {
  id         String      @id @default(uuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String
  content    String      @db.Text
  tokenCount Int?
  cached     Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([sessionId])
}

model TokenConsumptionLog {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appKey           String
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCostUsd Float
  cached           Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

model FeedbackCSAT {
  id        String      @id @default(uuid())
  sessionId String      @unique
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenantId  String
  rating    Int
  comment   String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  target    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}
